# ─── Public site URL ───────────────────────────────────────────────────────────
# Vercel auto-populates VERCEL_URL; override here for custom domains.
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ─── Figma / Payload (only needed when running inside Figma Make) ──────────────
# These are injected by the Figma Make sandbox. Leave blank on Vercel unless
# you are connecting a self-hosted Payload backend.
# FIGMA_CONTENT_API_URL=
# FIGMA_CONTENT_API_CONTENT_SYSTEM_ID=
# FIGMA_OAUTH_CLIENT_ID=

